# Flask Configuration
FLASK_APP=wsgi.py
FLASK_CONFIG=development

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-for-flask
JWT_SECRET_KEY=your-super-secret-key-for-jwt

# Database Configuration (for Flask App)
# Make sure the user, password, and db_name match the ones below
DATABASE_URL=postgresql://user:password@db:5432/vehiculos_db

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Docker-compose PostgreSQL service configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=vehiculos_db

# AWS S3-compatible Storage (for Backblaze, MinIO, etc.)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Mail Server Configuration (e.g., for Mailtrap, SendGrid, etc.)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=noreply@example.com
ADMIN_EMAIL_RECIPIENTS=admin@example.com
